# ── Lead delivery (app/api/lead) ─────────────────────────────────────
# Preferred: Resend (https://resend.com — free tier is fine).
# Without RESEND_API_KEY the route falls back to FormSubmit, which requires
# a ONE-TIME activation: submit the form once, then click the confirmation
# link FormSubmit emails to LEAD_EMAIL.
RESEND_API_KEY=
LEAD_FROM_EMAIL="ifBash Website <leads@ifbash.com>"
LEAD_EMAIL=connect@ifbash.com

# ── AI chatbot (app/api/chat) ────────────────────────────────────────
# Without a key the chat widget runs in guided mode (canned answers +
# lead capture). Add a key from https://platform.claude.com to enable
# real AI answers.
ANTHROPIC_API_KEY=

# Optional: override the chat model. Default is claude-haiku-4-5
# ($1/$5 per Mtok, ~$0.002 a reply) which is sized for this agent's job.
# claude-opus-5 answers better and costs roughly 5x more per reply.
CHAT_MODEL=

# ── Spend guards (lib/ai-limits.ts) ──────────────────────────────────
# The chat endpoint is public and unauthenticated, so these cap what a
# visitor — or a script — can spend. Defaults shown; raise or lower freely.
#
#   CHAT_MAX_PER_IP_10MIN   messages one IP may send in 10 minutes   (8)
#   CHAT_MAX_PER_IP_HOUR    messages one IP may send in an hour      (20)
#   CHAT_MAX_PER_DAY        messages from everyone, per UTC day      (400)
#
# At the Haiku default, 400 replies/day is about $0.90/day worst case —
# and normal traffic never comes close. Over the daily cap the widget
# silently drops to guided mode; per-IP limits return a friendly wait.
CHAT_MAX_PER_IP_10MIN=
CHAT_MAX_PER_IP_HOUR=
CHAT_MAX_PER_DAY=
#
# IMPORTANT — the limits above are best-effort: counters live in server
# memory, so a burst spread across cold serverless instances can slip past
# them. The only HARD ceiling is on Anthropic's side. Create a separate
# workspace + API key for this site in the Anthropic Console and set a
# spend limit on it, so a runaway can never touch the rest of your credit.

# ── Outbound phone calls (app/api/agent/call) ────────────────────────
# Retell AI (https://retellai.com): create an agent, buy/bind a number,
# then set both values. Without them, "Call me" requests are captured as
# priority callback leads instead of placing a live call.
RETELL_API_KEY=
RETELL_AGENT_NUMBER=
