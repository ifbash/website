# ── Lead delivery (app/api/lead) ─────────────────────────────────────
# Preferred: Resend (https://resend.com — free tier is fine).
# Without RESEND_API_KEY the route falls back to FormSubmit, which requires
# a ONE-TIME activation: submit the form once, then click the confirmation
# link FormSubmit emails to LEAD_EMAIL.
RESEND_API_KEY=
LEAD_FROM_EMAIL="ifBash Website <leads@ifbash.com>"
LEAD_EMAIL=connect@ifbash.com

# ── AI chatbot (app/api/chat) ────────────────────────────────────────
# Without a key the chat widget runs in guided mode (canned answers +
# lead capture). Add a key from https://platform.claude.com to enable
# real AI answers.
ANTHROPIC_API_KEY=
# Optional: override the chat model (default claude-opus-4-8).
# claude-haiku-4-5 is the lower-cost option.
CHAT_MODEL=

# ── Outbound phone calls (app/api/agent/call) ────────────────────────
# Retell AI (https://retellai.com): create an agent, buy/bind a number,
# then set both values. Without them, "Call me" requests are captured as
# priority callback leads instead of placing a live call.
RETELL_API_KEY=
RETELL_AGENT_NUMBER=
